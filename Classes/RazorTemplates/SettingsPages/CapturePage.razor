@using System.Linq;
@using RePlays.Services;
@using RePlays.Utils;
@using RePlays.Classes.RazorTemplates.Components;

@{
	var settings = SettingsService.Settings.captureSettings;

	var selectedCaptureModeText =
		settings.recordingMode == "whitelist" ? "settings.capture.captureMode.whitelist" :
		(settings.recordingMode == "manual" ? "settings.capture.captureMode.manual" :
		(settings.recordingMode == "none" ? "settings.capture.captureMode.disable" : "settings.capture.captureMode.automatic"));

	// 1440p is only offered if the display can actually produce it
	var ultraResolution = settings.maxScreenResolution >= 1440 ? 1440 : 1080;
	var resolutions = new List<int> { 480, 720, 1080 };
	if (settings.maxScreenResolution >= 1440) resolutions.Add(1440);
	var frameRates = new List<int> { 15, 30, 60, 120, 144 };

	// the preset is derived from the individual values rather than stored, so hand edits stay honest
	var preset =
		settings.resolution == 480 && settings.frameRate == 15 && settings.bitRate == 5 ? "low" :
		(settings.resolution == 720 && settings.frameRate == 30 && settings.bitRate == 25 ? "medium" :
		(settings.resolution == 1080 && settings.frameRate == 60 && settings.bitRate == 35 ? "high" :
		(settings.resolution == ultraResolution && settings.frameRate == 60 && settings.bitRate == 50 ? "ultra" : "custom")));
	var selectedVideoPreset = $"settings.capture.video.preset.{preset}";

	// the replay buffer can only write to formats that stay playable when the output is cut short
	var fileFormats = settings.useReplayBuffer
		? settings.fileFormatsCache.Where(f => f.isReplayBufferCompatible).ToList()
		: settings.fileFormatsCache;
	var isRecoverable = settings.useReplayBuffer ||
		settings.fileFormat.format == "mkv" ||
		settings.fileFormat.format == "fragmented_mp4" ||
		settings.fileFormat.format == "fragmented_mov";

	var showBitRate = settings.rateControl == "CBR" || settings.rateControl == "VBR";
	var showMaxBitRate = settings.rateControl == "VBR";
	var showCqLevel = settings.rateControl == "CQP" || settings.rateControl == "CRF";

	var unusedOutputs = settings.outputDevicesCache
		.Where(d => !settings.outputDevices.Any(x => x.deviceId == d.deviceId)).ToList();
	var unusedInputs = settings.inputDevicesCache
		.Where(d => !settings.inputDevices.Any(x => x.deviceId == d.deviceId)).ToList();
}

<script>
	// this fragment is re-rendered by the server on every change, so re-arm gamepad/keyboard focus
	if (window.$sn !== undefined) $sn.makeFocusable();
</script>

<div class="flex flex-col h-full">
	@* Capture Mode *@
	<Dropdown name="captureSettings[recordingMode]" label="settings.capture.captureMode" value="@settings.recordingMode" text="@selectedCaptureModeText"
			  items="@(new List<DropdownItem> {
				  DropdownItem.Translated("automatic", "settings.capture.captureMode.automatic"),
				  DropdownItem.Translated("whitelist", "settings.capture.captureMode.whitelist"),
				  DropdownItem.Translated("manual", "settings.capture.captureMode.manual"),
				  DropdownItem.Translated("none", "settings.capture.captureMode.disable")
			  })" />

	@* Replay Buffer *@
	<Toggle name="captureSettings[useReplayBuffer]" label="settings.capture.replayBuffer" hint="settings.capture.replayBuffer.hint" value="@settings.useReplayBuffer" />
	@if (settings.useReplayBuffer) {
		<div class="ml-8">
			<Input name="captureSettings[replayBufferDuration]" label="settings.capture.replayBuffer.duration"
				   value="@settings.replayBufferDuration.ToString()" min="10" suffix="settings.capture.unit.seconds" />
			<Input name="captureSettings[replayBufferSize]" label="settings.capture.replayBuffer.size"
				   value="@settings.replayBufferSize.ToString()" min="10" suffix="settings.capture.unit.megabytes" />
		</div>
	}

	@* Video Quality *@
	<h2 class="label-text font-bold pt-4 pb-1" hx-t="settings.capture.video" hx-ext="i18n" />
	<Dropdown name="preset" hx_put="/settings/capture/preset" label="settings.capture.video.preset" value="@preset" text="@selectedVideoPreset"
			  items="@(new List<DropdownItem> {
				  DropdownItem.Translated("low", "settings.capture.video.preset.low"),
				  DropdownItem.Translated("medium", "settings.capture.video.preset.medium"),
				  DropdownItem.Translated("high", "settings.capture.video.preset.high"),
				  DropdownItem.Translated("ultra", "settings.capture.video.preset.ultra")
			  })" />
	<div class="ml-8">
		@* Resolution *@
		<Dropdown name="captureSettings[resolution]" label="settings.capture.video.resolution" value="@settings.resolution.ToString()" text="@(settings.resolution + "p")"
				  items="@(resolutions.Select(r => DropdownItem.Literal(r.ToString(), r + "p")).ToList())" />
		@* Framerate *@
		<Dropdown name="captureSettings[frameRate]" label="settings.capture.video.framerate" value="@settings.frameRate.ToString()" text="@(settings.frameRate + " fps")"
				  items="@(frameRates.Select(f => DropdownItem.Literal(f.ToString(), f + " fps")).ToList())" />
		@* Encoder *@
		<Dropdown name="captureSettings[encoder]" label="settings.capture.video.encoder" value="@settings.encoder" text="@settings.encoder"
				  items="@(settings.encodersCache.Select(e => DropdownItem.Literal(e, e)).ToList())" />
		@* Rate control *@
		<Dropdown name="captureSettings[rateControl]" label="settings.capture.video.rate" value="@settings.rateControl" text="@settings.rateControl"
				  items="@(settings.rateControlCache.Select(r => DropdownItem.Literal(r, r)).ToList())" />
		@if (showBitRate) {
			<Input name="captureSettings[bitRate]" label="settings.capture.video.bitrate"
				   value="@settings.bitRate.ToString()" min="1" suffix="settings.capture.unit.bitrate" />
		}
		@if (showMaxBitRate) {
			<Input name="captureSettings[maxBitRate]" label="settings.capture.video.bitrate.max"
				   value="@settings.maxBitRate.ToString()" min="1" suffix="settings.capture.unit.bitrate" />
		}
		@if (showCqLevel) {
			<Input name="captureSettings[cqLevel]" label="settings.capture.video.cqLevel"
				   value="@settings.cqLevel.ToString()" min="1" max="51" suffix="settings.capture.unit.cqp" />
		}
		@* File format *@
		<Dropdown name="format" hx_put="/settings/capture/fileformat" label="settings.capture.video.format" value="@settings.fileFormat.format" text="@settings.fileFormat.title"
				  items="@(fileFormats.Select(f => DropdownItem.Literal(f.format, f.title)).ToList())" />
		@if (!isRecoverable) {
			<div role="alert" class="alert alert-info my-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				<div>
					<div class="font-bold">
						@settings.fileFormat.title <span hx-t="settings.capture.video.format.hint.title" hx-ext="i18n" />
					</div>
					<div class="text-xs" hx-t="settings.capture.video.format.hint.desc" hx-ext="i18n" />
				</div>
			</div>
		}
	</div>

	@* Audio *@
	<h2 class="label-text font-bold pt-4 pb-1" hx-t="settings.capture.audio" hx-ext="i18n" />
	<Toggle name="captureSettings[captureGameAudio]" label="settings.capture.audio.gameOnly" hint="settings.capture.audio.gameOnly.hint" value="@settings.captureGameAudio" />
	@if (!settings.captureGameAudio) {
		<div class="ml-8">
			<h3 class="label-text font-semibold pt-2" hx-t="settings.capture.audio.output" hx-ext="i18n" />
			@foreach (var device in settings.outputDevices) {
				<AudioDeviceRow device="@device"
								removable="@(!(settings.outputDevices.Count == 1 && device.deviceId == "default"))"
								hasNvidiaAudioSDK="@settings.hasNvidiaAudioSDK" />
			}
			<h3 class="label-text font-semibold pt-2" hx-t="settings.capture.audio.input" hx-ext="i18n" />
			@foreach (var device in settings.inputDevices) {
				<AudioDeviceRow device="@device"
								removable="@(!(settings.inputDevices.Count == 1 && device.deviceId == "default"))"
								hasNvidiaAudioSDK="@settings.hasNvidiaAudioSDK" />
			}
			@if (unusedOutputs.Count > 0 || unusedInputs.Count > 0) {
				<Dropdown name="device" hx_post="/settings/capture/audiodevice" label="settings.capture.audio.add" value="" text="settings.capture.audio.add.select"
						  items="@(unusedOutputs.Select(d => DropdownItem.Literal("output:" + d.deviceId, d.deviceLabel, "Output"))
								   .Concat(unusedInputs.Select(d => DropdownItem.Literal("input:" + d.deviceId, d.deviceLabel, "Input")))
								   .ToList())" />
			}
		</div>
	}

	@* Advanced *@
	<h2 class="label-text font-bold pt-4 pb-1" hx-t="settings.capture.advanced" hx-ext="i18n" />
	<Toggle name="captureSettings[useRecordingStartSound]" label="settings.capture.advanced.startSound" value="@settings.useRecordingStartSound" />
	<Toggle name="captureSettings[useDisplayCapture]" label="settings.capture.advanced.displayCapture" hint="settings.capture.advanced.displayCapture.hint" value="@settings.useDisplayCapture" />
	<Toggle name="captureSettings[captureHdr]" label="settings.capture.advanced.hdr" value="@settings.captureHdr" />
</div>
