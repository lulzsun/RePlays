<div hx-swap-oob="innerHTML:body">
    <div hx-ext="ws" ws-connect="/ws"/>
    <div id="modal-container"/>
    <div id="update-videos" hx-get="/videos" hx-vals='{"game": "All Games", "sortBy": "Latest"}' hx-trigger="load" />
    <div class="flex flex-row h-screen">
        <nav id="sidebar" class="z-[100] flex flex-col h-screen justify-between bg-base-200 w-auto absolute inset-y-0 left-0 transform -translate-x-full lg:relative lg:translate-x-0 transition duration-200 ease-in-out">
            <ul class="menu text-base-content w-48 p-4">
                <li><button class="btn focusable" onclick="showSessions();" hx-ext="i18n" hx-t="navbar.sessions" /></li>
                <li><button class="btn focusable" onclick="showClips();" hx-ext="i18n" hx-t="navbar.clips" /></li>
                <li><button class="btn focusable" onclick="showSettings();" hx-ext="i18n" hx-t="navbar.settings" /></li>
            </ul>
            <div id="toast-container"/>
        </nav>
        <div class="flex-1 overflow-y-auto">
            <div class="flex flex-col h-screen">
                <header class="py-5 bg-base-200 text-white text-center lg:hidden" onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full');">
                    RePlays
                </header>
                <input id="sessions-nav" type="radio" name="page-tabs" role="tab" class="tab !hidden" checked disabled />
                <div id="sessions-page" role="tabpanel" class="tab-content flex-1 overflow-y-auto">
                    <div role="status" class="w-full h-full flex items-center justify-center">
                        <svg aria-hidden="true" class="w-8 h-8 text-gray-600 animate-spin fill-gray-300" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor" />
                            <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill" />
                        </svg>
                    </div>
                </div>

                <input id="clips-nav" type="radio" name="page-tabs" role="tab" class="tab !hidden" disabled />
                <div id="clips-page" role="tabpanel" class="tab-content flex-1 overflow-y-auto">
                    <div role="status" class="w-full h-full flex items-center justify-center">
                        <svg aria-hidden="true" class="w-8 h-8 text-gray-600 animate-spin fill-gray-300" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor" />
                            <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill" />
                        </svg>
                    </div>
                </div>

                <input id="settings-nav" type="checkbox" class="modal-toggle" />
                <div id="settings-dialog" class="modal hidden" role="dialog">
                    <div class="modal-box w-11/12 max-w-5xl">
                        <form method="dialog">
                            <button class="focusable btn btn-sm btn-circle btn-ghost absolute right-2 top-2" onclick="document.getElementById('settings-nav').checked = false;">✕</button>
                        </form>
                        @* <h3 class="text-lg font-bold" hx-ext="i18n" hx-t="navbar.settings"/> *@
                        <div id="settings-page" role="tabpanel" class="flex-1 overflow-y-auto"/>
                    </div>
                    <label class="modal-backdrop" for="settings-nav">Close</label>
                </div>

                <input id="player-nav" type="radio" name="page-tabs" role="tab" class="tab !hidden" disabled />
                <div id="player-page" role="tabpanel" class="tab-content flex-1 overflow-y-auto">uninitialized...</div>

                <footer class="py-5 bg-base-100 text-white text-center bottom-0 hidden">
                    Footer
                </footer>
            </div>
        </div>
    </div>
</div>

<div hx-swap-oob="innerHTML:#player-page">
    <PlayerPage />
</div>

<SettingsPage />